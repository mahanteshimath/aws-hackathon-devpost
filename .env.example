# Copy to .env and fill in. .env is git-ignored - never commit real credentials.

# --- AWS credentials (use a dedicated least-privilege IAM user; rotate after judging) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=            # only for temporary credentials
AWS_REGION=us-east-1             # text models, Polly, Guardrails, background removal

# --- Mode ---
# mock  = no AWS calls (placeholder art, browser TTS) - for UI development
# aws   = real Bedrock (Nova + Stability AI) / Polly / Guardrails
CRAYON_MODE=mock

# --- Models (override if your account uses different IDs / inference profiles) ---
# Check what you can actually invoke:  python scripts/list_models.py
# Any Bedrock Converse model with vision + tool use works for the agents, e.g. Claude:
#   STORY_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
STORY_MODEL_ID=us.amazon.nova-2-lite-v1:0
CASTING_MODEL_ID=us.amazon.nova-2-lite-v1:0
# Images: Stability AI on Bedrock (Amazon Nova Canvas has reached end of life)
CUTOUT_MODEL_ID=us.stability.stable-image-remove-background-v1:0
SCENE_MODEL_ID=stability.sd3-5-large-v1:0
SCENE_REGION=us-west-2           # SD3.5 Large is served from us-west-2
IMAGE_CONCURRENCY=2

# --- Guardrails (created by infra/deploy.py or scripts/create_guardrail.py) ---
GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT

# --- Storage ---
# local = ./.data folder served by the dev server; s3 = bucket below
CRAYON_STORAGE=local
CRAYON_BUCKET=
CRAYON_TABLE=

# --- AgentCore (optional; leave blank to run the director in-process) ---
AGENTCORE_RUNTIME_ARN=
AGENTCORE_MEMORY_ID=

# --- Local dev server ---
CRAYON_PORT=8787
# Public base URL the phone uses (your Mac's LAN IP so the phone on the same Wi-Fi can reach it)
CRAYON_PUBLIC_URL=http://192.168.1.10:8787
